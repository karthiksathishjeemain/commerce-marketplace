# External PostgreSQL connection (required)
# Use your hosted database — Supabase, Neon, RDS, Railway, or a Postgres instance you manage.
# Example (Neon): postgresql://user:password@ep-xxx.region.aws.neon.tech/marketplace?sslmode=require
# Example (Supabase): postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth — use a random string at least 32 characters in production
JWT_SECRET="change-this-to-a-long-random-string-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# Stripe — get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
# Webhook secret from Stripe CLI or Dashboard (required for order confirmation)
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

FRONTEND_URL="http://localhost:3000"
PORT=4000
NODE_ENV=development
