{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "prisma generate && npm run build",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/health.ts": {
      "maxDuration": 10
    }
  }
}
